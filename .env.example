# MQTT connection for miscan. Copy to .env (never committed) and fill in:
#   cp .env.example .env && chmod 600 .env
# miscan reads .env from the current directory (or --env-file PATH). Variables that are
# already set in the environment take precedence. Same format as a systemd EnvironmentFile,
# so on the server this file can be /etc/miscan/env.

MISCAN_MQTT_HOST=127.0.0.1
MISCAN_MQTT_PORT=1883
MISCAN_MQTT_USERNAME=
MISCAN_MQTT_PASSWORD=

# Any other mqtt: setting works the same way, e.g.:
# MISCAN_MQTT_PREFIX=miscan2
# MISCAN_MQTT_CLIENT_ID=miscan2
