[Unit]
Description=miscan: Xiaomi BLE thermometers to MQTT
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service

[Service]
Type=simple
User=miscan
Group=miscan
# D-Bus access to BlueZ (org.bluez) is granted to the bluetooth group
SupplementaryGroups=bluetooth
WorkingDirectory=/opt/miscan
# Expects a virtual environment in /opt/miscan/.venv with miscan installed (see README, "As a systemd service")
ExecStart=/opt/miscan/.venv/bin/miscan --config /etc/miscan/miscan.yaml
# MISCAN_MQTT_HOST, _USERNAME, _PASSWORD, ... (same format as .env, see .env.example)
EnvironmentFile=-/etc/miscan/env
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
